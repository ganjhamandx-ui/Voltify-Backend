# Genera tu propia clave siguiendo README.md. Este archivo no contiene secretos reales.
DJANGO_SECRET_KEY=reemplazar-por-una-clave-generada
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_COOKIE_SECURE=False

# El bloqueo de login por cuenta es fijo: 3 fallos y 30 segundos.
# Su duración no se configura mediante variables de entorno.

# En este proyecto la base principal es voltify_e3. Nunca apuntar a voltify.
# El profesor debe usar una base NUEVA y exclusiva de su entorno.
DB_NAME=voltify_e3
DB_USER=usuario_local
DB_PASSWORD="reemplazar-por-tu-contrasena"
DB_HOST=127.0.0.1
DB_PORT=3306

# Opcional: ruta absoluta al SQLite de contadores. Predeterminado: .runtime/.
# LOGIN_SECURITY_DB=C:/ruta/privada/login_security.sqlite3
